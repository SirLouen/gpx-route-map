msgstr "Añade un botón en el mapa para que los visitantes descarguen el archivo GPX."

#: includes/class-plugin.php:194
#: includes/class-plugin.php:395
msgid "Stats shown"
msgstr "Estadísticas mostradas"

#: build/index.js:499
msgid "Stats bar items"
msgstr "Elementos de la barra de estadísticas"

#: build/index.js:503
msgid "Use site default"
msgstr "Usar el ajuste del sitio"

#: build/index.js:504
