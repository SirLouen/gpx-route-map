msgstr "Todas las pantallas (px)"

#: build/index.js:1326
msgid "Tablet (px)"
msgstr "Tableta (px)"

#: build/index.js:1332
msgid "Mobile (px)"
msgstr "Móvil (px)"

#: build/index.js:1327
msgid "Applies at 782px and below. Reset to follow the site setting, or the height above when the site has none."
msgstr "Se aplica a 782px o menos. Restablécelo para seguir el ajuste del sitio, o la altura de arriba si el sitio no define ninguna."

#: build/index.js:1333
msgid "Applies at 480px and below. Reset to follow the site setting, or the tablet height when the site has none."
msgstr "Se aplica a 480px o menos. Restablécelo para seguir el ajuste del sitio, o la altura de tableta si el sitio no define ninguna."

