msgid "GPX Route Map"
msgstr "GPX Route Map"

#. Plugin URI of the plugin
#: gpx-route-map.php
msgid "https://github.com/SirLouen/gpx-route-map"
msgstr ""

#. Description of the plugin
#: gpx-route-map.php
msgid "Attach a GPX track to any post or page and render it as an interactive OpenStreetMap map with waypoints, distance and an elevation profile."
msgstr "Adjunta una pista GPX a cualquier entrada o página y muéstrala como un mapa interactivo de OpenStreetMap con waypoints, distancia y un perfil de desnivel."

#. Author of the plugin
#: gpx-route-map.php
msgid "SirLouen <sir.louen@gmail.com>"
msgstr ""

#. Author URI of the plugin
#: gpx-route-map.php
msgid "https://github.com/SirLouen"
msgstr ""

#: includes/class-renderer.php:392
msgid "GPX Route Map: no GPX file selected."
msgstr "GPX Route Map: no se ha seleccionado ningún archivo GPX."

#: includes/class-renderer.php:399
msgid "GPX Route Map: plugin assets are not built. Run \"pnpm install && pnpm run build\" in the plugin directory."
msgstr "GPX Route Map: los recursos del plugin no están compilados. Ejecuta «pnpm install && pnpm run build» en el directorio del plugin."

#: includes/class-renderer.php:431
msgid "Interactive route map"
msgstr "Mapa interactivo de la ruta"

#: includes/class-renderer.php:554
msgid "Loading map…"
msgstr "Cargando el mapa…"

#: includes/class-renderer.php:555
msgid "Scroll or tap to load the interactive map"
msgstr "Desplázate o toca para cargar el mapa interactivo"

#: includes/class-renderer.php:567
msgid "Could not load GPX file."
msgstr "No se ha podido cargar el archivo GPX."

#: includes/class-renderer.php:568
msgid "Could not load GPX file: its host does not allow cross-origin (CORS) requests. Upload the file to this site instead."
msgstr "No se ha podido cargar el archivo GPX: su servidor no permite peticiones de origen cruzado (CORS). Sube el archivo a este sitio en su lugar."

#: includes/class-renderer.php:569
msgid "Invalid GPX file."
msgstr "Archivo GPX no válido."

#: includes/class-renderer.php:570
msgid "No track or route points found in GPX file."
msgstr "No se han encontrado puntos de pista ni de ruta en el archivo GPX."

