{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/trunk/schemas/json/wp-env.json",
	"phpVersion": "8.2",
	"plugins": [ ".", "https://downloads.wordpress.org/plugin/plugin-check.zip" ],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp rewrite structure '/%postname%/' --hard"
	}
}
